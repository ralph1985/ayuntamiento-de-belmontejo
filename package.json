{
  "name": "ayuntamiento-de-belmontejo",
  "type": "module",
  "version": "0.22.3",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "scripts": {
    "astro": "astro dev",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro dev",
    "commit": "git-cz",
    "fetch-bandos": "node scripts/fetch-bandos.js",
    "discover-news": "node scripts/run-news-discovery.js",
    "discover-news:dry-run": "NEWS_DRY_RUN=1 node scripts/run-news-discovery.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:unit": "vitest --run",
    "test:unit:coverage": "vitest --run --coverage",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:navigation": "node scripts/run-e2e.js --group flows:navigation",
    "sonar:scan": "dotenv -e .env -- sonar-scanner",
    "version:suggest": "node scripts/suggest-version-bump.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "11.0.3",
    "@project-manager/pm-weather": "https://raw.githubusercontent.com/ralph1985/project-manager/5cec3858ff6ed5b469591d48ba240471439b9d3f/artifacts/project-manager-pm-weather-0.2.0.tgz",
    "@types/simple-oauth2": "5.0.7",
    "astro": "7.1.0",
    "autoprefixer": "10.4.22",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "less": "4.8.1",
    "maplibre-gl": "5.24.0",
    "nodemailer": "9.0.5",
    "sharp": "0.35.0",
    "simple-oauth2": "5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@playwright/test": "1.62.1",
    "@types/cors": "2.8.19",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.50.1",
    "@vitest/coverage-v8": "4.1.10",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.0.1",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.7.4",
    "prettier-plugin-astro": "0.14.1",
    "sonarqube-scanner": "5.0.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "path-to-regexp": "6.3.0",
      "node-forge": "1.3.3",
      "inquirer": "8.2.7",
      "sharp": "0.35.0",
      "tmp": "0.2.5"
    }
  }
}
