<button
  id="dark-mode-toggle"
  type="button"
  aria-label="Activar modo oscuro"
  aria-pressed="false"
>
  <svg
    class="cs-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 480 480"
    style="enable-background:new 0 0 480 480"
    xml:space="preserve"
    ><path
      d="M459.782 347.328c-4.288-5.28-11.488-7.232-17.824-4.96-17.76 6.368-37.024 9.632-57.312 9.632-97.056 0-176-78.976-176-176 0-58.4 28.832-112.768 77.12-145.472 5.472-3.712 8.096-10.4 6.624-16.832S285.638 2.4 279.078 1.44C271.59.352 264.134 0 256.646 0c-132.352 0-240 107.648-240 240s107.648 240 240 240c84 0 160.416-42.688 204.352-114.176 3.552-5.792 3.04-13.184-1.216-18.496z"
    ></path></svg
  >
  <img
    class="cs-sun"
    aria-hidden="true"
    src="/assets/icons/sun.svg"
    decoding="async"
    alt="Sol"
    width="15"
    height="15"
  />
</button>

<script>
  const syncThemeToggle = element => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    element.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    element.setAttribute(
      'aria-label',
      isDark ? 'Activar modo claro' : 'Activar modo oscuro'
    );
  };

  const setToggleListener = () => {
    const darkModeToggleButton = document.getElementById('dark-mode-toggle');
    if (
      !darkModeToggleButton ||
      darkModeToggleButton.dataset.listenerAttached
    ) {
      return;
    }

    const handleToggleClick = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      window.__applyMunicipalTheme?.(isDark ? 'light' : 'dark', true);
      syncThemeToggle(darkModeToggleButton);
    };

    darkModeToggleButton.addEventListener('click', handleToggleClick);
    darkModeToggleButton.dataset.listenerAttached = 'true';
    syncThemeToggle(darkModeToggleButton);
  };

  setToggleListener();

  if (!document.documentElement.dataset.themeToggleSyncAttached) {
    document.addEventListener('municipal:theme-change', () => {
      const toggle = document.getElementById('dark-mode-toggle');
      if (toggle) syncThemeToggle(toggle);
    });
    document.documentElement.dataset.themeToggleSyncAttached = 'true';
  }

  document.addEventListener('astro:after-swap', setToggleListener);
</script>
