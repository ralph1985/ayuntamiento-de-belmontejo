---
export interface Props {
  id: string;
  question: string;
  isActive?: boolean;
}

const { id, question, isActive = false } = Astro.props;
const classes = ['cs-faq-item', isActive ? 'active' : '']
  .filter(Boolean)
  .join(' ');
---

<li class={classes} data-question={question}>
  <button
    class="cs-button"
    type="button"
    aria-expanded={isActive ? 'true' : 'false'}
    aria-controls={`${id}-answer`}
  >
    <span class="cs-button-text">{question}</span>
  </button>
  <div id={`${id}-answer`} class="cs-item-text" hidden={!isActive}>
    <slot />
  </div>
</li>
