---
import NavIcon from '@components/ui/NavIcon.astro';
import type { InstagramPost } from '@data/instagramPosts';

interface Props {
  post: InstagramPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props as Props;
const postType =
  post.mediaType === 'REELS' || post.mediaType === 'VIDEO' ? 'Reel' : 'Imagen';
const formattedDate = post.publishedAt
  ? new Intl.DateTimeFormat('es-ES', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(new Date(post.publishedAt))
  : null;
---

<article
  class:list={['instagram-card', { 'instagram-card--featured': featured }]}
>
  <a
    class="instagram-card__media"
    href={post.permalink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Ver en Instagram: ${post.title}`}
  >
    {
      post.imageUrl ? (
        <img src={post.imageUrl} alt="" loading="lazy" decoding="async" />
      ) : (
        <span class="instagram-card__placeholder" aria-hidden="true">
          <span class="instagram-card__placeholder-mark">IG</span>
          <span>{postType}</span>
        </span>
      )
    }
    <span class="instagram-card__type">{postType}</span>
  </a>

  <div class="instagram-card__body">
    <div class="instagram-card__meta">
      <span>{post.category}</span>
      {
        formattedDate && (
          <time datetime={post.publishedAt ?? undefined}>{formattedDate}</time>
        )
      }
    </div>
    <h3>
      <a href={post.permalink} target="_blank" rel="noopener noreferrer"
        >{post.title}</a
      >
    </h3>
    <p>{post.summary}</p>
    <a
      class="instagram-card__link"
      href={post.permalink}
      target="_blank"
      rel="noopener noreferrer"
    >
      Leer en Instagram <NavIcon name="arrow" size={16} />
    </a>
  </div>
</article>

<style lang="less">
  .instagram-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    &__media {
      position: relative;
      display: block;
      overflow: hidden;
      background: var(--color-surface-muted);
      color: var(--color-text-inverse);
      text-decoration: none;

      &:focus-visible {
        outline-offset: -3px;
      }

      img {
        display: block;
        width: 100%;
        height: auto;
        transition: transform 0.35s ease;
      }

      &:hover img {
        transform: scale(1.03);
      }
    }

    &__placeholder {
      display: grid;
      aspect-ratio: 4 / 3;
      width: 100%;
      height: 100%;
      place-content: center;
      gap: 0.75rem;
      background: linear-gradient(
        135deg,
        var(--color-surface-inverse),
        var(--color-link)
      );
      color: var(--color-text-inverse);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-align: center;
      text-transform: uppercase;
    }

    &__placeholder-mark {
      display: grid;
      width: 3.5rem;
      height: 3.5rem;
      place-items: center;
      margin: auto;
      border: 1px solid rgb(255 255 255 / 55%);
      border-radius: 1rem;
      font-size: 1.1rem;
      letter-spacing: 0.04em;
    }

    &__type {
      position: absolute;
      right: 0.75rem;
      bottom: 0.75rem;
      padding: 0.35rem 0.6rem;
      border-radius: var(--radius-pill);
      background: rgb(14 25 23 / 82%);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    &__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      padding: 1.25rem;
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      color: var(--color-territory-strong);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    h3 {
      margin-top: 0.65rem;
      font-size: 1.35rem;
      line-height: 1.15;

      a {
        color: inherit;
        text-decoration: none;

        &:hover,
        &:focus-visible {
          color: var(--color-link-hover);
          text-decoration: underline;
          text-underline-offset: 0.15em;
        }
      }
    }

    p {
      margin-top: 0.7rem;
      color: var(--color-text-muted);
      line-height: 1.55;
    }

    &__link {
      width: fit-content;
      margin-top: auto;
      padding-top: 1rem;
      color: var(--color-link);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 0.2em;

      .nav-icon {
        margin-left: 0.2rem;
        vertical-align: middle;
        transition: transform 0.2s ease;
      }

      &:hover .nav-icon,
      &:focus-visible .nav-icon {
        transform: translate(2px, -2px);
      }
    }

    &--featured {
      @media (min-width: 60rem) {
        grid-column: span 2;
        flex-direction: row;

        .instagram-card__media {
          width: 52%;
          display: flex;
          align-items: center;
          min-height: 100%;
        }

        .instagram-card__body {
          justify-content: center;
          padding: clamp(1.5rem, 3vw, 2.5rem);
        }

        h3 {
          font-size: clamp(1.6rem, 2.5vw, 2.35rem);
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-card,
    .instagram-card__media img,
    .instagram-card__link .nav-icon {
      transition: none;
    }
  }
</style>
