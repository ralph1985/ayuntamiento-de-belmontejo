---
import contactInfo, {
  getActiveSocialEntries,
  getPrimaryEmail,
  getPrimaryOffice,
  getPrimaryPhone,
} from '@js/contact';
import navData from '@data/navData.json';
import footerServices from '@data/footerServices.json';
import MunicipalSeal from '@components/ui/MunicipalSeal.astro';
import NavIcon from '@components/ui/NavIcon.astro';
import { resolveFooterServiceLink } from '@components/layout/footer.helpers';
import { getCurrentYear } from '@js/utils';

const currentYear = getCurrentYear();
const primaryOffice = getPrimaryOffice();
const primaryPhone = getPrimaryPhone();
const primaryEmail = getPrimaryEmail();
const weatherCoordinates = primaryOffice?.coordinates;
const socialEntries = getActiveSocialEntries();
const officeLocationLines = primaryOffice
  ? [
      primaryOffice.street,
      [primaryOffice.locality, primaryOffice.region].filter(Boolean).join(', '),
      primaryOffice.postalCode,
    ].filter(Boolean)
  : [];

const socialIconMap: Record<
  string,
  {
    viewBox: string;
    path: string;
  }
> = {
  facebook: {
    viewBox: '0 0 24 24',
    path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  instagram: {
    viewBox: '0 0 24 24',
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  },
};

const filteredNavData = navData;
const footerIconForEntry: Record<
  string,
  'home' | 'village' | 'projects' | 'news' | 'notice' | 'search'
> = {
  Inicio: 'home',
  'Sobre el pueblo': 'village',
  Proyectos: 'projects',
  Noticias: 'news',
  Bandos: 'notice',
  Buscador: 'search',
};
---

<!-- ============================================ --><!--                   Footer                     --><!-- ============================================ -->
<footer id="footer">
  <div class="site-container">
    <div class="footer-brand">
      <a class="logo" href="/" aria-label="Ir a la página de inicio"
        ><MunicipalSeal
          class="footer-logo-img"
          alt="Ayuntamiento de Belmontejo"
          width={264}
          height={78}
          loading="lazy"
        /></a
      >
      <p class="footer-brand__eyebrow">Sitio web oficial</p>
      <h2>{contactInfo.entity.name}</h2>
      <p class="footer-brand__description">
        Información municipal, bandos y servicios para Belmontejo.
      </p>
    </div>
    <div class="footer-content">
      <div class="footer-link-grid">
        <ul class="footer-list">
          <li>
            <h2><NavIcon name="village" size={19} />Información</h2>
          </li>
          {
            filteredNavData.map(entry => (
              <li class="cs-li">
                <a href={entry.url}>
                  <NavIcon name={footerIconForEntry[entry.key]} size={17} />
                  <span>{entry.key}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="footer-list">
          <li>
            <h2><NavIcon name="projects" size={19} />Servicios</h2>
          </li>
          {
            footerServices.services
              .filter(service => service.url)
              .map(service => {
                const serviceLink = resolveFooterServiceLink(service);

                return (
                  <li>
                    {serviceLink.isLink && service.url ? (
                      <a
                        href={service.url}
                        target={serviceLink.target}
                        rel={serviceLink.rel}
                      >
                        {service.title}
                      </a>
                    ) : (
                      service.title
                    )}
                  </li>
                );
              })
          }
        </ul>
        <ul class="footer-list footer-list--contact">
          <li>
            <h2><NavIcon name="notice" size={19} />Contacto</h2>
          </li>
          {
            primaryOffice && (
              <li>
                {primaryOffice.mapsUrl ? (
                  <a
                    href={primaryOffice.mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {officeLocationLines.map((line, index) => (
                      <>
                        {line}
                        {index < officeLocationLines.length - 1 && <br />}
                      </>
                    ))}
                  </a>
                ) : (
                  <span>
                    {officeLocationLines.map((line, index) => (
                      <>
                        {line}
                        {index < officeLocationLines.length - 1 && <br />}
                      </>
                    ))}
                  </span>
                )}
              </li>
            )
          }
          {
            primaryPhone && (
              <li>
                <a href={`tel:${primaryPhone.href}`}>
                  T:
                  {primaryPhone.display}
                </a>
              </li>
            )
          }
          {
            primaryEmail && (
              <li>
                <a
                  href={`mailto:${primaryEmail.address}`}
                  aria-label={`Enviar correo a ${primaryEmail.label}`}
                >
                  Correo electrónico
                </a>
              </li>
            )
          }
        </ul>
        <ul class="footer-list footer-list--social">
          <li>
            <h2><NavIcon name="news" size={19} />Síguenos</h2>
          </li>
          {
            socialEntries.map(([networkId, network]) => {
              const icon = socialIconMap[networkId] ?? null;

              return (
                <li class="cs-li">
                  <a
                    href={network.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                  >
                    {icon && (
                      <svg
                        class="social-icon"
                        viewBox={icon.viewBox}
                        aria-hidden="true"
                      >
                        <path d={icon.path} />
                      </svg>
                    )}
                    {network.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <ul class="footer-list footer-list--weather">
          <li>
            <h2><NavIcon name="village" size={19} />El tiempo</h2>
          </li>
          {
            weatherCoordinates ? (
              <li class="weather-item weather-item--footer">
                <pm-weather
                  variant="compact"
                  locale="es-ES"
                  latitude={weatherCoordinates.latitude}
                  longitude={weatherCoordinates.longitude}
                  link-url="/tiempo"
                />
              </li>
            ) : null
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-legal">
    <div class="footer-legal__inner site-container">
      <nav aria-label="Información legal">
        <a href="/politica-de-privacidad">Política de Privacidad</a>
        <a href="/politica-de-cookies">Política de Cookies</a>
        <a href="/aviso-legal">Aviso Legal</a>
      </nav>
      <div class="footer-credits">
        <p>© {currentYear} {contactInfo.entity.name}</p>
        <p>
          Web realizada por{' '}
          <a
            href="https://conquense.dev"
            target="_blank"
            rel="noopener noreferrer"
          >
            conquense.dev
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style lang="less">
  @import '../../styles/components/footer.less';
</style>
