---
import Button from '@components/ui/Button.astro';
import InstagramPostCard from '@components/content/InstagramPostCard.astro';
import NavIcon from '@components/ui/NavIcon.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import {
  groupInstagramPostsByMonth,
  publishedInstagramPosts,
} from '@data/instagramPosts';
import type { InstagramPost } from '@data/instagramPosts';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  limit?: number;
  allPosts?: boolean;
  posts?: InstagramPost[];
  variant?: 'archive' | 'home';
}

const {
  eyebrow,
  title,
  description,
  buttonLabel,
  buttonHref,
  limit,
  allPosts = false,
  posts: pagePosts,
  variant = 'archive',
} = Astro.props as Props;
const sourcePosts =
  pagePosts ??
  (variant === 'home'
    ? publishedInstagramPosts
    : allPosts
      ? publishedInstagramPosts
      : publishedInstagramPosts);
const posts = limit ? sourcePosts.slice(0, limit) : sourcePosts;
const monthGroups =
  variant === 'archive' ? groupInstagramPostsByMonth(posts) : [];
---

<section
  class:list={['instagram-feed', `instagram-feed--${variant}`]}
  aria-label={title}
>
  <div class="instagram-feed__inner site-container site-container--wide">
    <div class="instagram-feed__heading-row">
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
      {
        variant === 'home' && (
          <a
            class="instagram-feed__profile-link"
            href="https://www.instagram.com/aytobelmontejo/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Perfil oficial <NavIcon name="arrow" size={16} />
          </a>
        )
      }
    </div>

    {
      posts.length > 0 ? (
        variant === 'archive' ? (
          <>
            <nav class="instagram-month-index" aria-label="Navegar por meses">
              <span class="instagram-month-index__label">
                Publicaciones por mes
              </span>
              <ul>
                {monthGroups.map(month => (
                  <li>
                    <a href={`#instagram-month-${month.key}`}>
                      {month.label}
                      <span aria-label={`${month.posts.length} publicaciones`}>
                        ({month.posts.length})
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <div class="instagram-months">
              {monthGroups.map(month => (
                <section
                  class="instagram-month"
                  id={`instagram-month-${month.key}`}
                  aria-labelledby={`instagram-month-title-${month.key}`}
                >
                  <div class="instagram-month__heading">
                    <h3 id={`instagram-month-title-${month.key}`}>
                      {month.label}
                    </h3>
                    <span aria-label={`${month.posts.length} publicaciones`}>
                      {month.posts.length}
                    </span>
                  </div>
                  <div class="instagram-feed__grid">
                    {month.posts.map(post => (
                      <InstagramPostCard post={post} />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </>
        ) : (
          <div class="instagram-feed__grid">
            {posts.map((post, index) => (
              <InstagramPostCard
                post={post}
                featured={variant === 'home' && index === 0}
              />
            ))}
          </div>
        )
      ) : (
        <p class="instagram-feed__empty">
          Todavía no hay publicaciones disponibles.
        </p>
      )
    }

    <div class="instagram-feed__actions">
      <Button href={buttonHref} variant="secondary">{buttonLabel}</Button>
    </div>
  </div>
</section>

<style lang="less">
  .instagram-feed {
    background: var(--color-bg);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .instagram-month-index {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    padding-block: 1rem;
    border-block: 1px solid var(--color-border);
  }

  .instagram-month-index__label {
    flex: 0 0 auto;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .instagram-month-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
  }

  .instagram-month-index a {
    color: var(--color-link);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .instagram-month-index a span {
    margin-left: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.875em;
    font-weight: 400;
  }

  .instagram-month {
    scroll-margin-top: 6rem;
  }

  .instagram-month + .instagram-month {
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-border);
  }

  .instagram-month__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .instagram-month__heading h3 {
    font-size: clamp(1.6rem, 3vw, 2.35rem);
    line-height: 1.1;
  }

  .instagram-month__heading > span {
    flex: 0 0 auto;
    color: var(--color-territory-strong);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .instagram-feed__heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .instagram-feed__profile-link {
    flex: 0 0 auto;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;

    .nav-icon {
      margin-left: 0.2rem;
      vertical-align: middle;
    }
  }

  .instagram-feed__actions {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .instagram-feed__empty {
    color: var(--color-text-muted);
  }

  .instagram-feed--home {
    background: var(--color-bg-subtle);

    .instagram-feed__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .instagram-feed__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 60rem) {
    .instagram-feed__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 34rem;
      margin-inline: auto;
    }

    .instagram-feed__heading-row {
      display: block;
    }

    .instagram-month-index {
      display: block;
    }

    .instagram-month-index__label {
      display: block;
      margin-bottom: 0.75rem;
    }

    .instagram-feed__profile-link {
      display: inline-block;
      margin: -1.5rem 0 2rem;
    }

    .instagram-feed--home .instagram-feed__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
