---
import Button from '@components/ui/Button.astro';
import InstagramPostCard from '@components/content/InstagramPostCard.astro';
import NavIcon from '@components/ui/NavIcon.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import {
  publishedInstagramPosts,
  getInstagramPageUrl,
} from '@data/instagramPosts';
import type { InstagramPost } from '@data/instagramPosts';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  limit?: number;
  allPosts?: boolean;
  posts?: InstagramPost[];
  currentPage?: number;
  totalPages?: number;
  variant?: 'archive' | 'home';
}

const {
  eyebrow,
  title,
  description,
  buttonLabel,
  buttonHref,
  limit,
  allPosts = false,
  posts: pagePosts,
  currentPage = 1,
  totalPages = 1,
  variant = 'archive',
} = Astro.props as Props;
const sourcePosts =
  pagePosts ??
  (variant === 'home'
    ? publishedInstagramPosts
    : allPosts
      ? publishedInstagramPosts
      : publishedInstagramPosts);
const posts = limit ? sourcePosts.slice(0, limit) : sourcePosts;
---

<section
  class:list={['instagram-feed', `instagram-feed--${variant}`]}
  aria-label={title}
>
  <div class="instagram-feed__inner site-container site-container--wide">
    <div class="instagram-feed__heading-row">
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
      {
        variant === 'home' && (
          <a
            class="instagram-feed__profile-link"
            href="https://www.instagram.com/aytobelmontejo/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Perfil oficial <NavIcon name="arrow" size={16} />
          </a>
        )
      }
    </div>

    {
      posts.length > 0 ? (
        <div class="instagram-feed__grid">
          {posts.map((post, index) => (
            <InstagramPostCard
              post={post}
              featured={variant === 'home' && index === 0}
            />
          ))}
        </div>
      ) : (
        <p class="instagram-feed__empty">
          Todavía no hay publicaciones disponibles.
        </p>
      )
    }

    <div class="instagram-feed__actions">
      <Button href={buttonHref} variant="secondary">{buttonLabel}</Button>
    </div>

    {
      totalPages > 1 && (
        <nav class="instagram-pagination" aria-label="Paginación de Instagram">
          {currentPage > 1 ? (
            <a href={getInstagramPageUrl(currentPage - 1)}>Anterior</a>
          ) : (
            <span aria-disabled="true">Anterior</span>
          )}
          <span aria-current="page">
            Página {currentPage} de {totalPages}
          </span>
          {currentPage < totalPages ? (
            <a href={getInstagramPageUrl(currentPage + 1)}>Siguiente</a>
          ) : (
            <span aria-disabled="true">Siguiente</span>
          )}
        </nav>
      )
    }
  </div>
</section>

<style lang="less">
  .instagram-feed {
    background: var(--color-bg);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .instagram-feed__heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .instagram-feed__profile-link {
    flex: 0 0 auto;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;

    .nav-icon {
      margin-left: 0.2rem;
      vertical-align: middle;
    }
  }

  .instagram-feed__actions {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .instagram-feed__empty {
    color: var(--color-text-muted);
  }

  .instagram-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .instagram-pagination a {
    color: var(--color-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .instagram-pagination span[aria-disabled='true'] {
    color: var(--color-text-muted);
    opacity: 0.55;
  }

  .instagram-feed--home {
    background: var(--color-bg-subtle);

    .instagram-feed__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .instagram-feed__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 60rem) {
    .instagram-feed__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 34rem;
      margin-inline: auto;
    }

    .instagram-feed__heading-row {
      display: block;
    }

    .instagram-feed__profile-link {
      display: inline-block;
      margin: -1.5rem 0 2rem;
    }

    .instagram-feed--home .instagram-feed__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
