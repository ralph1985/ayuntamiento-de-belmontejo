---
import Button from '@components/ui/Button.astro';
import InstagramEmbed from '@components/content/InstagramEmbed.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import {
  featuredInstagramPosts,
  publishedInstagramPosts,
  getInstagramPageUrl,
} from '@data/instagramPosts';
import type { InstagramPost } from '@data/instagramPosts';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  limit?: number;
  allPosts?: boolean;
  posts?: InstagramPost[];
  currentPage?: number;
  totalPages?: number;
}

const {
  eyebrow,
  title,
  description,
  buttonLabel,
  buttonHref,
  limit,
  allPosts = false,
  posts: pagePosts,
  currentPage = 1,
  totalPages = 1,
} = Astro.props as Props;
const sourcePosts =
  pagePosts ??
  (allPosts
    ? publishedInstagramPosts
    : featuredInstagramPosts.length > 0
      ? featuredInstagramPosts
      : publishedInstagramPosts);
const posts = limit ? sourcePosts.slice(0, limit) : sourcePosts;
---

<section class="instagram-feed" aria-label={title}>
  <div class="instagram-feed__inner site-container site-container--wide">
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />

    {
      posts.length > 0 ? (
        <div class="instagram-feed__grid">
          {posts.map(post => (
            <InstagramEmbed post={post} />
          ))}
        </div>
      ) : (
        <p class="instagram-feed__empty">
          Todavía no hay publicaciones disponibles.
        </p>
      )
    }

    <div class="instagram-feed__actions">
      <Button href={buttonHref} variant="secondary">{buttonLabel}</Button>
    </div>

    {
      totalPages > 1 && (
        <nav class="instagram-pagination" aria-label="Paginación de Instagram">
          {currentPage > 1 ? (
            <a href={getInstagramPageUrl(currentPage - 1)}>Anterior</a>
          ) : (
            <span aria-disabled="true">Anterior</span>
          )}
          <span aria-current="page">
            Página {currentPage} de {totalPages}
          </span>
          {currentPage < totalPages ? (
            <a href={getInstagramPageUrl(currentPage + 1)}>Siguiente</a>
          ) : (
            <span aria-disabled="true">Siguiente</span>
          )}
        </nav>
      )
    }
  </div>
</section>

<script is:inline>
  (() => {
    const processInstagramEmbeds = () => {
      if (window.instgrm?.Embeds?.process) {
        window.instgrm.Embeds.process();
      }
    };

    if (!document.querySelector('script[data-instagram-embed-script]')) {
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.instagram.com/embed.js';
      script.dataset.instagramEmbedScript = 'true';
      script.onload = processInstagramEmbeds;
      document.head.appendChild(script);
    }

    processInstagramEmbeds();
    document.addEventListener('astro:page-load', processInstagramEmbeds);
  })();
</script>

<style lang="less">
  .instagram-feed {
    background: var(--color-bg);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .instagram-feed__actions {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .instagram-feed__empty {
    color: var(--color-text-muted);
  }

  .instagram-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .instagram-pagination a {
    color: var(--color-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .instagram-pagination span[aria-disabled='true'] {
    color: var(--color-text-muted);
    opacity: 0.55;
  }

  @media (max-width: 60rem) {
    .instagram-feed__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 34rem;
      margin-inline: auto;
    }
  }
</style>
