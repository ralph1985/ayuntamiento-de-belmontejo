---
import Button from '@components/ui/Button.astro';
import InstagramPostCard from '@components/content/InstagramPostCard.astro';
import NavIcon from '@components/ui/NavIcon.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { publishedInstagramPosts } from '@data/instagramPosts';
import type { InstagramPost } from '@data/instagramPosts';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  limit?: number;
  allPosts?: boolean;
  posts?: InstagramPost[];
  monthLabel?: string;
  monthKey?: string;
  isFallback?: boolean;
  archiveHref?: string;
  archiveLinkLabel?: string;
  variant?: 'archive' | 'home';
}

const {
  eyebrow,
  title,
  description,
  buttonLabel,
  buttonHref,
  limit,
  allPosts = false,
  posts: pagePosts,
  monthLabel,
  monthKey,
  isFallback = false,
  archiveHref,
  archiveLinkLabel = 'Ver archivo',
  variant = 'archive',
} = Astro.props as Props;
const sourcePosts =
  pagePosts ??
  (variant === 'home'
    ? publishedInstagramPosts
    : allPosts
      ? publishedInstagramPosts
      : publishedInstagramPosts);
const posts = limit ? sourcePosts.slice(0, limit) : sourcePosts;
---

<section
  class:list={['instagram-feed', `instagram-feed--${variant}`]}
  aria-label={title}
>
  <div class="instagram-feed__inner site-container site-container--wide">
    <div class="instagram-feed__heading-row">
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
      {
        variant === 'home' && (
          <a
            class="instagram-feed__profile-link"
            href="https://www.instagram.com/aytobelmontejo/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Perfil oficial <NavIcon name="arrow" size={16} />
          </a>
        )
      }
    </div>

    {
      posts.length > 0 ? (
        <div
          class="instagram-period"
          id={monthKey ? `instagram-month-${monthKey}` : undefined}
        >
          {monthLabel && (
            <div class="instagram-period__heading">
              <h3>{monthLabel}</h3>
              <span aria-label={`${posts.length} publicaciones`}>
                {posts.length}
              </span>
            </div>
          )}
          {isFallback && (
            <p class="instagram-feed__fallback">
              Mostramos el último mes con publicaciones mientras llega la
              actualidad de este mes.
            </p>
          )}
          <div class="instagram-feed__grid">
            {posts.map((post, index) => (
              <InstagramPostCard
                post={post}
                featured={variant === 'home' && index === 0}
              />
            ))}
          </div>
        </div>
      ) : (
        <p class="instagram-feed__empty">
          Todavía no hay publicaciones disponibles en Instagram.
        </p>
      )
    }

    <div class="instagram-feed__actions">
      <Button href={buttonHref} variant="secondary">{buttonLabel}</Button>
      {
        archiveHref && (
          <a class="instagram-feed__archive-link" href={archiveHref}>
            {archiveLinkLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style lang="less">
  .instagram-feed {
    background: var(--color-bg);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .instagram-period {
    scroll-margin-top: 6rem;
  }

  .instagram-period__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .instagram-period__heading h3 {
    font-size: clamp(1.6rem, 3vw, 2.35rem);
    line-height: 1.1;
  }

  .instagram-period__heading > span {
    flex: 0 0 auto;
    color: var(--color-territory-strong);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .instagram-feed__heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .instagram-feed__profile-link {
    flex: 0 0 auto;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;

    .nav-icon {
      margin-left: 0.2rem;
      vertical-align: middle;
    }
  }

  .instagram-feed__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .instagram-feed__archive-link {
    color: var(--color-link);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .instagram-feed__fallback {
    margin: -0.5rem 0 1.5rem;
    color: var(--color-text-muted);
  }

  .instagram-feed__empty {
    color: var(--color-text-muted);
  }

  .instagram-feed--home {
    background: var(--color-bg-subtle);

    .instagram-feed__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .instagram-feed__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 60rem) {
    .instagram-feed__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 34rem;
      margin-inline: auto;
    }

    .instagram-feed__heading-row {
      display: block;
    }

    .instagram-feed__profile-link {
      display: inline-block;
      margin: -1.5rem 0 2rem;
    }

    .instagram-feed--home .instagram-feed__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
