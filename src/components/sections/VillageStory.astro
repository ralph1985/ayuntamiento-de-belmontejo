---
import Button from '@components/ui/Button.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  body: string;
  image: string;
  imageAlt: string;
  buttonLabel: string;
  buttonHref: string;
}

const {
  eyebrow,
  title,
  description,
  body,
  image,
  imageAlt,
  buttonLabel,
  buttonHref,
} = Astro.props as Props;
---

<section class="village-story">
  <div class="village-story__inner site-container site-container--wide">
    <div class="village-story__media">
      <img
        src={image}
        alt={imageAlt}
        width="1920"
        height="1080"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="village-story__content">
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
      <p>{body}</p>
      <Button href={buttonHref} variant="secondary">{buttonLabel}</Button>
    </div>
  </div>
</section>

<style lang="less">
  .village-story {
    background: var(--background-main);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .village-story__inner {
    display: grid;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }
  .village-story__media {
    min-height: 25rem;
    position: relative;
  }
  .village-story__media img {
    border-radius: 1rem;
    object-fit: cover;
    position: absolute;
  }
  .village-story__media img {
    width: 100%;
    height: 100%;
    inset: 0;
  }
  .village-story__content > p {
    color: var(--text-secondary);
    line-height: 1.65;
    margin: -1.5rem 0 2rem;
    max-width: 38rem;
  }
  @media (min-width: 48rem) {
    .village-story__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }
  }
</style>
