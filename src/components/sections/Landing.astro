---
interface Props {
  title: string;
  image: {
    src: string;
    width: number;
    height: number;
  };
}

const { title, image } = Astro.props as Props;
---

<section id="int-hero" aria-labelledby="page-hero-title">
  <div class="page-hero__inner">
    <p class="page-hero__eyebrow">Ayuntamiento de Belmontejo</p>
    <h1 id="page-hero-title">{title}</h1>

    <div class="page-hero__summary">
      <slot />
    </div>
  </div>

  <div class="page-hero__media" aria-hidden="true">
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      decoding="async"
      alt=""
      loading="eager"
    />
  </div>
</section>

<style lang="less">
  @import '../../styles/components/landing.less';
</style>
