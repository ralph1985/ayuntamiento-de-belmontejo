---
import { Picture } from 'astro:assets';

interface Props {
  title: string;
  image: {
    src: string;
    width: number;
    height: number;
  };
}

const { title, image } = Astro.props as Props;
---

<section id="int-hero" aria-labelledby="page-hero-title">
  <div class="page-hero__inner">
    <p class="page-hero__eyebrow">Ayuntamiento de Belmontejo</p>
    <h1 id="page-hero-title">{title}</h1>

    <div class="page-hero__summary">
      <slot />
    </div>
  </div>

  <!-- standard <picture> attributes are supported. Set loading to lazy for assets below the fold -->
  <!-- Note: because we use the getImage function to generate an optimized image, we need to use special properties. More info on [the getImage() page](https://docs.astro.build/en/guides/images/#generating-images-with-getimage) -->
  <div class="page-hero__media" aria-hidden="true">
    <Picture
      src={image.src}
      width={image.width}
      height={image.height}
      formats={['webp']}
      decoding="async"
      alt=""
      loading="eager"
    />
  </div>
</section>

<style lang="less">
  @import '../../styles/components/landing.less';
</style>
