---
import Button from '@components/ui/Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  desktopImage: string;
  mobileImage: string;
}

const {
  eyebrow,
  title,
  summary,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  desktopImage,
  mobileImage,
} = Astro.props as Props;
---

<section id="hero" class="home-hero" aria-labelledby="home-hero-title">
  <picture class="home-hero__media" aria-hidden="true">
    <source media="(max-width: 600px)" srcset={mobileImage} />
    <img
      src={desktopImage}
      alt=""
      width="2500"
      height="1667"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="home-hero__overlay"></div>
  <div class="home-hero__content">
    <p class="home-hero__eyebrow">{eyebrow}</p>
    <h1 id="home-hero-title">{title}</h1>
    <p class="home-hero__summary">{summary}</p>
    <div class="home-hero__actions">
      <Button href={primaryHref}>{primaryLabel}</Button>
      <Button href={secondaryHref} variant="ghost" class="home-hero__secondary"
        >{secondaryLabel}</Button
      >
    </div>
  </div>
</section>

<style lang="less">
  .home-hero {
    min-height: min(48rem, 100dvh);
    overflow: hidden;
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;

    &__media,
    &__media img,
    &__overlay {
      inset: 0;
      position: absolute;
      width: 100%;
      height: 100%;
    }
    &__media {
      z-index: -2;
    }
    &__media img {
      object-fit: cover;
    }
    &__overlay {
      background: linear-gradient(
        90deg,
        rgb(14 31 39 / 0.84),
        rgb(14 31 39 / 0.52) 58%,
        rgb(14 31 39 / 0.25)
      );
      z-index: -1;
    }
    &__content {
      width: min(100% - 2rem, 75rem);
      margin: 0 auto;
      padding: clamp(8.5rem, 18vw, 12rem) 0 clamp(4rem, 10vw, 7rem);
      color: var(--text-white);
    }
    &__eyebrow {
      color: var(--hero-eyebrow);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      margin-bottom: 1rem;
      text-transform: uppercase;
    }
    h1 {
      color: inherit;
      font-size: clamp(2.85rem, 7.5vw, 5.75rem);
      letter-spacing: -0.06em;
      line-height: 0.96;
      max-width: 10ch;
    }
    &__summary {
      color: inherit;
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      line-height: 1.55;
      margin-top: 1.5rem;
      max-width: 34rem;
    }
    &__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 2rem;
    }
    :global(.home-hero__secondary) {
      --button-ghost-border: rgb(255 255 255 / 0.7);
      --button-ghost-color: var(--text-white);
      --button-ghost-fill: rgb(255 255 255 / 0.16);
      --button-ghost-hover-color: var(--text-white);
    }
  }
  @media (max-width: 47.9375rem) {
    .home-hero__overlay {
      background: linear-gradient(
        0deg,
        rgb(14 31 39 / 0.86),
        rgb(14 31 39 / 0.35)
      );
    }
  }
</style>
