---
/**
 * * Example use case of the CSPicture component if you need to use different images on mobile and desktop, for art direction.
 * * If you're fine with using the same image on all devices, you can use an >Image /> or <Picture /> component.
 **/
// Import the component and all the images you want to use with it
import CSPicture from '@components/content/CSPicture.astro';
const mobileImage = '/assets/images/cta-belmontejo-mobile.webp';
const desktopImage = '/assets/images/cta-belmontejo.webp';
const fallbackImage = desktopImage;
import Button from '@components/ui/Button.astro';

interface Props {
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  imageAlt: string;
}

const { title, description, buttonLabel, buttonHref, imageAlt } = Astro.props;
---

<section id="cta">
  <div class="container">
    <h2 class="title">{title}</h2>
    <p>{description}</p>
    <Button href={buttonHref}>{buttonLabel}</Button>
  </div>
  <CSPicture
    mobileImgUrl={mobileImage}
    mobileMediaWidth="600px"
    desktopImgUrl={desktopImage}
    desktopMediaWidth="601px"
    fallbackImgUrl={fallbackImage}
    alt={imageAlt}
  />
</section>

<style lang="less">
  @import '../../styles/components/cta.less';
</style>
