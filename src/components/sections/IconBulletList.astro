---
import type { IconBulletItem } from '@types/content';

interface Props {
  id?: string;
  class?: string;
  items: IconBulletItem[];
}

const {
  id = 'icon-bullet-list',
  class: customClass = '',
  items = [],
} = Astro.props as Props;

const sectionClass = ['services', customClass].filter(Boolean).join(' ');
---

<section id={id} class={sectionClass} aria-label="Conoce Belmontejo">
  {
    items.map(item => (
      <article class="card">
        <picture>
          <img
            aria-hidden="true"
            decoding="async"
            src={item.icon}
            alt={item.iconAlt}
            width={item.iconWidth ?? 48}
            height={item.iconHeight ?? 48}
          />
        </picture>
        <h2>{item.title}</h2>
        <p>{item.description}</p>
      </article>
    ))
  }
</section>

<style lang="less" is:global>
  @media only screen and (min-width: 0em) {
    .services {
      width: min(100% - 2rem, 75rem);
      margin: clamp(2.5rem, 5vw, 4rem) auto;
      padding: clamp(1.5rem, 4vw, 3rem);
      background: var(--background-sections);
      border: 1px solid var(--border-color);
      border-radius: 1rem;
      position: relative;
      z-index: 100;

      .card {
        width: 100%;
        max-width: 22rem;
        margin: auto;
        margin-bottom: 2.5rem;
        display: block;

        &:last-of-type {
          margin-bottom: 0;
        }

        picture {
          width: 3.5rem;
          height: 3.5rem;
          margin: auto;
          margin-bottom: 1.25rem;
          background: var(--secondary);
          border-radius: 0.75rem;
          display: flex;
          justify-content: center;
          align-items: center;

          img {
            width: 2rem;
            height: 2rem;
          }
        }

        h2 {
          font-size: 1.25rem;
          font-weight: 700;
          line-height: 1.2;
          text-align: left;
          margin-bottom: 0.75rem;
          color: var(--text-primary);
        }

        p {
          line-height: 1.6;
          text-align: left;
          width: 100%;
          opacity: 1;
        }
      }
    }
  }

  @media only screen and (min-width: 768px) {
    .services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;

      .card {
        max-width: none;
        margin: 0;
      }
    }
  }

  @media only screen and (min-width: 1300px) {
    .services {
      padding: 3.5rem 4rem;

      .card {
        max-width: none;
      }
    }
  }

  @media only screen and (min-width: 0em) {
    body.dark-mode {
      .services {
        background: var(--medium);

        picture {
          background: var(--primary);
        }

        h2 {
          font-weight: bold;
          color: var(--text-primary);
        }
      }
    }
  }
</style>
