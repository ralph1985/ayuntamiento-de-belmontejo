---
import SocialMediaLinks from '@components/layout/SocialMediaLinks.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props as Props;
---

<section class="home-community">
  <div class="home-community__inner site-container site-container--wide">
    <div class="home-community__intro">
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
      <SocialMediaLinks className="homepage-social" />
    </div>
  </div>
</section>

<style lang="less">
  .home-community {
    background: var(--color-bg);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .home-community__inner {
    display: grid;
    gap: 3rem;
  }
</style>
