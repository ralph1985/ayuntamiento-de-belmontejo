---
import SocialMediaLinks from '@components/layout/SocialMediaLinks.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
---

<section class="home-community">
  <div class="home-community__inner">
    <div class="home-community__intro">
      <SectionHeading
        eyebrow="Comunidad"
        title="Actualidad y redes"
        description="Sigue la actualidad municipal y consulta las redes del Ayuntamiento."
      />
      <SocialMediaLinks className="homepage-social" />
    </div>
  </div>
</section>

<style lang="less">
  .home-community {
    background: var(--background-main);
    padding: clamp(4rem, 9vw, 8rem) 1rem;
  }
  .home-community__inner {
    width: min(100%, 75rem);
    margin: auto;
    display: grid;
    gap: 3rem;
  }
</style>
