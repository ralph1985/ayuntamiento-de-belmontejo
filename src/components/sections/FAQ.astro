---
import { getCollection, render } from 'astro:content';
import FaqItem from '@components/faq/FaqItem.astro';

export interface Props {
  id: string;
}

const { id: sectionId } = Astro.props;

const faqCollection = await getCollection('faqs');
const sortedFaqs = faqCollection.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

const faqEntries = await Promise.all(
  sortedFaqs.map(async faq => {
    const { Content } = await render(faq);
    return {
      id: faq.id,
      question: faq.data.question,
      isDefaultOpen: faq.data.isDefaultOpen ?? false,
      Content,
    };
  })
);

const defaultActiveId =
  faqEntries.find(faq => faq.isDefaultOpen)?.id ?? faqEntries[0]?.id ?? null;
---

<section id={`faq-${sectionId}`} class="faq-section" data-faq-section>
  <div class="site-container site-container--wide">
    <div class="cs-content">
      <span class="cs-topper">Preguntas frecuentes</span>
      <h2 class="cs-title">Preguntas frecuentes de Belmontejo</h2>
    </div>
    <div class="cs-flex-group">
      {
        faqEntries.length ? (
          <ul class="cs-faq-group">
            {faqEntries.map(({ id, question, Content }) => (
              <FaqItem
                id={`faq-${sectionId}-${id}`}
                question={question}
                isActive={id === defaultActiveId}
              >
                <Content />
              </FaqItem>
            ))}
          </ul>
        ) : (
          <p class="cs-item-text">
            Estamos preparando las preguntas frecuentes. Por favor, vuelve más
            tarde.
          </p>
        )
      }
    </div>
  </div>
</section>

<script>
  const initializeFaqSections = () => {
    const sections =
      document.querySelectorAll<HTMLElement>('[data-faq-section]');

    for (const section of sections) {
      if (section.dataset.faqInitialized === 'true') continue;
      section.dataset.faqInitialized = 'true';

      section.addEventListener('click', event => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const button = target.closest('.cs-button');
        if (
          !(button instanceof HTMLButtonElement) ||
          !section.contains(button)
        ) {
          return;
        }

        const item = button.closest('.cs-faq-item');
        const answerId = button.getAttribute('aria-controls');
        const answer = answerId ? section.querySelector(`#${answerId}`) : null;
        if (!item || !(answer instanceof HTMLElement)) return;

        const isActive = item.classList.toggle('active');
        button.setAttribute('aria-expanded', String(isActive));
        answer.hidden = !isActive;
      });
    }
  };

  document.addEventListener('astro:page-load', initializeFaqSections);
  initializeFaqSections();
</script>

<style lang="less" is:global>
  @import '../../styles/components/faq.less';
</style>
