---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Información en preparación',
  description = 'La información de esta iniciativa municipal se publicará próximamente.',
} = Astro.props as Props;
---

<section class="project-pending" aria-labelledby="project-pending-title">
  <div class="project-pending__inner">
    <h2 id="project-pending-title">{title}</h2>
    <p>{description}</p>
  </div>
</section>

<style lang="less">
  .project-pending {
    padding: clamp(4rem, 8vw, 7rem) 1rem;
  }
  .project-pending__inner {
    width: min(100%, 46rem);
    margin: auto;
    padding: clamp(2rem, 5vw, 4rem);
    background: var(--background-sections);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
  }
  .project-pending h2 {
    color: var(--text-primary);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .project-pending p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 1rem;
  }
</style>
