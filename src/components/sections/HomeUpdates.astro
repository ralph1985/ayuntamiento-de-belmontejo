---
import FeaturedContent from '@components/sections/FeaturedContent.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  bandosButtonLabel: string;
  bandosButtonHref: string;
}

const {
  eyebrow,
  title,
  description,
  buttonLabel,
  buttonHref,
  bandosButtonLabel,
  bandosButtonHref,
} = Astro.props as Props;
---

<section class="home-updates">
  <div class="home-updates__inner">
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />
    <FeaturedContent type="both" limit={6} />
    <div class="home-updates__actions">
      <Button href={buttonHref} variant="secondary">{buttonLabel}</Button>
      <Button href={bandosButtonHref} variant="secondary">
        {bandosButtonLabel}
      </Button>
    </div>
  </div>
</section>

<style lang="less">
  .home-updates {
    background: var(--background-sections);
    padding: clamp(4rem, 9vw, 8rem) 1rem;
  }
  .home-updates__inner {
    width: min(100%, 75rem);
    margin: auto;
  }
  .home-updates__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 30rem) {
    .home-updates__actions .c-button {
      width: 100%;
    }
  }
</style>
