---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import CTA from '@components/sections/CTA.astro';
import Landing from '@components/sections/Landing.astro';
import FAQ from '@components/sections/FAQ.astro';
import GoogleMap from '@components/integrations/GoogleMap.astro';
import Button from '@components/ui/Button.astro';
import VillageFeature from '@components/sections/VillageFeature.astro';
import { aboutVillage } from '@data/aboutVillage';
import { homePage } from '@data/homePage';

import landingImage from '@data/landingImage';
---

<BaseLayout
  title={aboutVillage.pageTitle}
  description={aboutVillage.pageDescription}
  preloadedImage={landingImage}
>
  <!-- ============================================ -->
  <!--                    LANDING                   -->
  <!-- ============================================ -->

  <Landing title={aboutVillage.landingTitle} image={landingImage}>
    <p>{aboutVillage.landingIntro}</p>
  </Landing>

  <!-- ============================================ -->
  <!--                 Side By Side                 -->
  <!-- ============================================ -->

  <section id="historia">
    <div class="cs-container">
      <!-- Left Image Section -->
      <div class="cs-left">
        <picture class="cs-picture cs-picture1">
          <source
            media="(max-width: 600px)"
            srcset={aboutVillage.overviewImages[0].mobileSrc}
          />
          <source
            media="(min-width: 601px)"
            srcset={aboutVillage.overviewImages[0].desktopSrc}
          />
          <img
            decoding="async"
            src={aboutVillage.overviewImages[0].desktopSrc}
            alt={aboutVillage.overviewImages[0].alt}
            loading="lazy"
            width="400"
            height="563"
          />
          {
            aboutVillage.overviewImages[0].credit &&
            aboutVillage.overviewImages[0].creditHref ? (
              <span class="image-credit">
                Imagen:{' '}
                <a
                  href={aboutVillage.overviewImages[0].creditHref}
                  rel="noreferrer"
                >
                  {aboutVillage.overviewImages[0].credit}
                </a>
              </span>
            ) : null
          }
        </picture>
        <picture class="cs-picture cs-picture2">
          <source
            media="(max-width: 600px)"
            srcset={aboutVillage.overviewImages[1].mobileSrc}
          />
          <source
            media="(min-width: 601px)"
            srcset={aboutVillage.overviewImages[1].desktopSrc}
          />
          <img
            decoding="async"
            src={aboutVillage.overviewImages[1].desktopSrc}
            alt={aboutVillage.overviewImages[1].alt}
            loading="lazy"
            width="400"
            height="563"
          />
        </picture>
      </div>
      <!-- Right Content Section-->
      <div class="cs-right">
        <span class="cs-topper">{aboutVillage.overviewEyebrow}</span>
        <h2 class="cs-title">{aboutVillage.overviewTitle}</h2>
        <p class="cs-text">{aboutVillage.overviewDescription}</p>
        <h3 class="cs-h3">{aboutVillage.historyTitle}</h3>
        {
          aboutVillage.historyParagraphs.map(paragraph => (
            <p class="cs-text">{paragraph}</p>
          ))
        }
        <div class="cs-flex-group">
          <p class="cs-flex-p">{aboutVillage.quote}</p>
          <span class="cs-name">{aboutVillage.quoteAuthor}</span>
          <span class="cs-job">{aboutVillage.quoteRole}</span>
          <img
            class="cs-quote-icon"
            loading="lazy"
            decoding="async"
            src="/assets/images/graphics/quote-white.svg"
            alt=""
            aria-hidden="true"
            width="136"
            height="77"
          />
        </div>
        <Button href="/contacto">Contactar</Button>
      </div>
    </div>
  </section>

  {aboutVillage.features.map(feature => <VillageFeature {...feature} />)}

  <!-- ============================================ -->
  <!--                 Vista Aérea                  -->
  <!-- ============================================ -->

  <section id="vista-aerea">
    <div class="cs-container">
      <div class="cs-content">
        <span class="cs-topper">{aboutVillage.videoEyebrow}</span>
        <h2 class="cs-title">{aboutVillage.videoTitle}</h2>
        <p class="cs-text">{aboutVillage.videoDescription}</p>
      </div>
      <div class="cs-video-wrapper">
        <iframe
          src={aboutVillage.videoUrl}
          width="400"
          height="300"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          title={aboutVillage.videoTitleAttribute}></iframe>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--                 Google Map                   -->
  <!-- ============================================ -->

  <GoogleMap
    title={aboutVillage.mapTitle}
    subtitle={aboutVillage.mapSubtitle}
    description={aboutVillage.mapDescription}
  />

  <FAQ id="about" />
  <CTA {...homePage.cta} />
</BaseLayout>

<style lang="less">
  @import '../styles/pages/sobre-el-pueblo.less';
</style>
