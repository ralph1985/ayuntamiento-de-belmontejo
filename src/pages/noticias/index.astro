---
/**
 * * This page is the noticias index and displays all the articles in a grid
 **/

import BaseLayout from '@layouts/BaseLayout.astro';
import CTA from '@components/sections/CTA.astro';
import ContentArchive from '@components/sections/ContentArchive.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

import Landing from '@components/sections/Landing.astro';

const posts = await getCollection('noticias');
posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)
import landingImage from '@assets/images/vista-aerea-2.jpg'; // <-- THE PATH TO THE ASSET YOU WANT TO PRELOAD - The asset must live in src
const optimizedImage = await getImage({ src: landingImage, format: 'avif' });
---

<BaseLayout
  title="Noticias - Ayuntamiento de Belmontejo"
  description="Noticias, actividades y novedades del Ayuntamiento de Belmontejo para vecinos y visitantes."
  preloadedImage={optimizedImage}
>
  <Landing title="Noticias" image={optimizedImage}>
    <p>Noticias y avisos del Ayuntamiento de Belmontejo.</p>
  </Landing>

  <ContentArchive
    posts={posts}
    kind="news"
    heading="Noticias publicadas"
    searchLabel="Buscar en las noticias"
    searchPlaceholder="Título, contenido o autor"
    resultSingular="noticia publicada"
    resultPlural="noticias publicadas"
    emptyMessage="No hay noticias publicadas."
    linkLabel="Continuar leyendo"
  />
  <CTA />
</BaseLayout>
