---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/ui/SearchBox.astro';
import Landing from '../components/sections/Landing.astro';
import landingImage from '@data/landingImage';
---

<BaseLayout
  title="Buscador - Ayuntamiento de Belmontejo"
  description="Busca en todas las noticias y bandos del Ayuntamiento de Belmontejo"
  preloadedImage={landingImage}
>
  <div id="main-content">
    <Landing title="Buscador" image={landingImage}>
      <p>
        Busca información en las noticias y bandos del Ayuntamiento de
        Belmontejo.
      </p>
    </Landing>

    <!-- ============================================ -->
    <!--                Search Section              -->
    <!-- ============================================ -->
    <section id="search-section" class="cs-search-section">
      <div class="site-container site-container--wide">
        <div class="cs-search-wrapper">
          <SearchBox />
        </div>

        <div class="cs-search-tips">
          <h3>Consejos para buscar:</h3>
          <ul>
            <li>
              Usa palabras clave específicas como "agua", "obras", "servicios
              sociales"
            </li>
            <li>Combina varios términos para resultados más precisos</li>
            <li>
              La búsqueda incluye títulos, descripciones y contenido completo
            </li>
            <li>
              Los resultados se muestran ordenados por fecha (más recientes
              primero)
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style lang="less">
  @import '../styles/pages/buscar.less';
</style>
