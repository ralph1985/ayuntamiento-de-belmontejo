---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import Landing from '@components/sections/Landing.astro';
import CTA from '@components/sections/CTA.astro';
import NavIcon from '@components/ui/NavIcon.astro';
import { homePage } from '@data/homePage';
import placeData from '@data/placesOfInterest.json';
import landingImage from '@data/landingImage';

const mapTitle = 'Mapa de lugares de interés de Belmontejo';
const pageTitle = 'Descubre Belmontejo - Ayuntamiento de Belmontejo';
const pageDescription =
  'Lugares de interés, patrimonio, naturaleza y servicios para descubrir Belmontejo, en la provincia de Cuenca.';
const mapsUrl = (place: (typeof placeData.places)[number]) =>
  place.mapsUrl ??
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapsQuery ?? `${place.name}, Belmontejo, Cuenca`)}`;
const placeSchema = placeData.places.map(place => ({
  '@type': 'TouristAttraction',
  name: place.name,
  description: place.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Belmontejo',
    addressRegion: 'Cuenca',
    addressCountry: 'ES',
  },
  url: new URL(
    place.detailHref ?? `/descubre-belmontejo/#${place.id}`,
    'https://belmontejo.conquense.dev/'
  ).href,
}));
const mapPlaces = placeData.places.filter(
  place =>
    typeof place.latitude === 'number' &&
    typeof place.longitude === 'number' &&
    typeof place.mapIcon === 'string'
);
const mapPlacesJson = mapPlaces.map(place => ({
  id: place.id,
  name: place.name,
  category: place.category,
  description: place.description,
  address: place.address,
  mapIcon: place.mapIcon,
  latitude: place.latitude,
  longitude: place.longitude,
  mapsUrl: mapsUrl(place),
}));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadedImage={landingImage}
>
  <Landing title="Descubre Belmontejo" image={landingImage}>
    <p>
      Patrimonio, naturaleza y lugares de la vida cotidiana para conocer el
      municipio a tu ritmo.
    </p>
  </Landing>

  <section class="discover-intro" aria-labelledby="discover-intro-title">
    <div class="site-container site-container--reading">
      <span class="cs-topper">Lugares de interés</span>
      <h2 class="cs-title" id="discover-intro-title">
        Un pueblo para recorrerlo despacio
      </h2>
      <p class="cs-text">
        Consulta el mapa y elige un lugar. La información se revisa antes de
        incorporarla y los negocios locales pueden cambiar sus horarios.
      </p>
    </div>
  </section>

  <section class="discover-map-section" aria-labelledby="discover-map-title">
    <div class="site-container site-container--wide">
      <div class="discover-map-section__heading">
        <div>
          <span class="cs-topper">Mapa</span>
          <h2 id="discover-map-title">Lugares de interés</h2>
        </div>
        <a
          class="discover-map-section__link"
          href={placeData.mapLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir en Google Maps <NavIcon name="arrow" size={17} />
        </a>
      </div>
      <div class="discover-map-wrapper">
        <div
          id="discover-map"
          class="discover-map"
          role="region"
          aria-label={mapTitle}
          data-map-container
        >
        </div>
        <p class="discover-map-status" data-map-status role="status">
          Cargando el mapa...
        </p>
      </div>
    </div>
  </section>

  <section class="discover-places" aria-labelledby="places-title">
    <div class="site-container site-container--wide">
      <div class="discover-places__heading">
        <div>
          <span class="cs-topper">Explora</span>
          <h2 id="places-title">Qué ver y dónde parar</h2>
        </div>
        <p
          class="discover-places__summary"
          data-places-summary
          aria-live="polite"
        >
          {placeData.places.length} lugares
        </p>
      </div>

      <form class="discover-filters" data-discover-filters role="search">
        <label for="place-category">Filtrar por tipo</label>
        <select id="place-category" name="categoria" data-place-category>
          {
            placeData.categories.map(category => (
              <option value={category === 'Todos' ? '' : category}>
                {category}
              </option>
            ))
          }
        </select>
        <button type="button" class="discover-filters__clear" data-place-clear>
          Mostrar todos
        </button>
      </form>

      <div class="discover-places__grid" data-place-results>
        {
          placeData.places.map(place => (
            <article
              class="place-card"
              id={place.id}
              data-place-card
              data-category={place.category}
            >
              {place.image && (
                <img
                  src={place.image}
                  alt={place.imageAlt ?? ''}
                  loading="lazy"
                  width="640"
                  height="360"
                />
              )}
              <div class="place-card__body">
                <p class="place-card__category">{place.category}</p>
                <h3>{place.name}</h3>
                <p>{place.description}</p>
                <p class="place-card__address">{place.address}</p>
                <div class="place-card__actions">
                  <a
                    href={mapsUrl(place)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Cómo llegar <NavIcon name="arrow" size={16} />
                  </a>
                  {place.detailHref && (
                    <a href={place.detailHref}>Más información</a>
                  )}
                  {typeof place.latitude === 'number' &&
                    typeof place.longitude === 'number' && (
                      <a
                        href="#discover-map"
                        data-map-focus={place.id}
                        aria-controls="discover-map"
                      >
                        Ver en el mapa
                      </a>
                    )}
                </div>
                {place.sourceHref && place.sourceLabel && (
                  <p class="place-card__source">
                    Fuente:{' '}
                    <a
                      href={place.sourceHref}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {place.sourceLabel}
                    </a>
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>
      <p class="discover-empty" data-place-empty hidden>
        No hay lugares en esta categoría.
      </p>
    </div>
  </section>

  <CTA {...homePage.cta} />
</BaseLayout>

<script
  id="places-map-data"
  type="application/json"
  is:inline
  set:html={JSON.stringify(mapPlacesJson)}
/>

<script>
  import * as L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type MapPlace = {
    id: string;
    name: string;
    category: string;
    description: string;
    address: string;
    mapIcon?: string;
    latitude: number;
    longitude: number;
    mapsUrl: string;
  };

  const mapPlaces = JSON.parse(
    document.getElementById('places-map-data')?.textContent ?? '[]'
  ) as MapPlace[];
  let focusMapPlace: Function | null = null;

  const markerSvg = (icon: string) => {
    const paths: Record<string, string[]> = {
      heritage: [
        'M4 21h16',
        'M5 21V10a7 7 0 0 1 14 0v11',
        'M9 21v-7M15 21v-7M4 10h16',
      ],
      civic: [
        'M3 21h18',
        'M5 21v-9l7-4 7 4v9',
        'M8 21v-5h3v5M13 16h3v5M12 8V4M9 6h6',
      ],
      pool: [
        'M3 12c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 4-2',
        'M3 17c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 4-2',
      ],
      nature: [
        'M20 4C11 4 5 8 5 15c0 3 2 5 5 5 7 0 10-7 10-16Z',
        'M4 21c3-5 7-8 13-11',
      ],
    };
    const selectedPaths = paths[icon] ?? paths.civic;
    return `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">${selectedPaths.map(path => `<path d="${path}"></path>`).join('')}</svg>`;
  };

  const setMapStatus = (message: string, isError = false) => {
    const status = document.querySelector('[data-map-status]');
    if (status) {
      status.textContent = message;
      status.classList.toggle('is-error', isError);
    }
  };

  const createPopup = (place: MapPlace) => {
    const wrapper = document.createElement('div');
    const title = document.createElement('h3');
    title.textContent = place.name;
    const description = document.createElement('p');
    description.textContent = place.description;
    const address = document.createElement('p');
    address.textContent = place.address;
    const link = document.createElement('a');
    link.href = place.mapsUrl;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = 'Cómo llegar';
    wrapper.append(title, description, address, link);
    return wrapper;
  };

  const initializeMap = async () => {
    const container = document.querySelector<HTMLElement>(
      '[data-map-container]'
    );
    if (!container || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    if (!mapPlaces.length) {
      setMapStatus(
        'Todavía no hay ubicaciones verificadas para mostrar.',
        true
      );
      return;
    }

    const reduceMotion = globalThis.matchMedia?.(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const map = L.map(container, {
      zoomControl: true,
      scrollWheelZoom: false,
      dragging: true,
      doubleClickZoom: true,
      keyboard: true,
    }).setView([39.8219639, -2.3477587], 16);
    const baseLayer = L.tileLayer(
      'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 20,
      }
    ).addTo(map);

    const markerEntries = mapPlaces.map(place => {
      const icon = L.divIcon({
        className: `place-map-icon-wrap place-map-icon-wrap--${place.mapIcon ?? 'default'}`,
        html: `<button type="button" class="place-map-icon place-map-icon--${place.mapIcon ?? 'default'}" aria-label="Ver ${place.name}">${markerSvg(place.mapIcon ?? 'civic')}</button>`,
        iconSize: [48, 48],
        iconAnchor: [24, 48],
        popupAnchor: [0, -48],
      });
      const marker = L.marker([place.latitude, place.longitude], {
        icon,
        keyboard: false,
        title: place.name,
      }).addTo(map);
      const markerButton = marker.getElement()?.querySelector('button');
      markerButton?.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          marker.togglePopup();
        }
      });
      const label = document.createElement('span');
      label.className = `place-map-tooltip place-map-tooltip--${place.mapIcon ?? 'default'}`;
      label.textContent = place.name;
      label.setAttribute('aria-hidden', 'true');
      marker.bindTooltip(label, {
        permanent: true,
        direction: 'top',
        offset: [0, -42],
        opacity: 1,
        className: `place-map-tooltip-container place-map-tooltip-container--${place.mapIcon ?? 'default'}`,
      });
      marker.bindPopup(
        L.popup({ offset: [0, -42] }).setContent(createPopup(place))
      );
      return { place, marker };
    });

    baseLayer.on('tileerror', () => {
      setMapStatus(
        'No se pudo cargar el mapa. El listado sigue disponible.',
        true
      );
    });

    const fitVisibleMarkers = (entries: typeof markerEntries) => {
      if (entries.length > 1) {
        const bounds = L.latLngBounds(
          entries.map(
            ({ place }) => [place.latitude, place.longitude] as L.LatLngTuple
          )
        );
        map.fitBounds(bounds, {
          padding: [64, 64],
          maxZoom: 17,
          animate: !reduceMotion,
        });
      } else if (entries.length === 1) {
        const { place } = entries[0];
        map.setView([place.latitude, place.longitude], 17, {
          animate: !reduceMotion,
          duration: 0.45,
        });
      }
    };

    fitVisibleMarkers(markerEntries);
    setMapStatus('');

    const filterMap = (category: string) => {
      const visibleMarkers = markerEntries.filter(
        ({ place }) => !category || place.category === category
      );
      markerEntries.forEach(({ place, marker }) => {
        const shouldShow = !category || place.category === category;
        if (shouldShow) marker.addTo(map);
        else map.removeLayer(marker);
      });
      fitVisibleMarkers(visibleMarkers);
      setMapStatus(
        visibleMarkers.length
          ? ''
          : 'No hay ubicaciones verificadas en esta categoría. Consulta el listado.',
        visibleMarkers.length === 0
      );
    };

    focusMapPlace = id => {
      const entry = markerEntries.find(({ place }) => place.id === id);
      if (!entry) return;
      entry.marker.addTo(map);
      map.setView([entry.place.latitude, entry.place.longitude], 17, {
        animate: !reduceMotion,
        duration: 0.45,
      });
      entry.marker.openPopup();
    };

    document
      .querySelector('[data-place-category]')
      ?.addEventListener('change', event => {
        filterMap((event.target as HTMLSelectElement).value);
      });
  };

  document.addEventListener('click', async event => {
    const target = event.target as HTMLElement;
    const focusLink = target.closest<HTMLElement>('[data-map-focus]');
    const placeId = focusLink?.dataset.mapFocus;
    if (!placeId) return;
    event.preventDefault();
    await initializeMap();
    focusMapPlace?.(placeId);
    document.querySelector('[data-map-container]')?.scrollIntoView({
      behavior: globalThis.matchMedia?.('(prefers-reduced-motion: reduce)')
        .matches
        ? 'auto'
        : 'smooth',
      block: 'center',
    });
  });

  const observeMap = () => {
    const container = document.querySelector('[data-map-container]');
    if (!container || container.dataset.observerInitialized) return;
    container.dataset.observerInitialized = 'true';
    if (!('IntersectionObserver' in globalThis)) {
      initializeMap();
      return;
    }
    const observer = new IntersectionObserver(
      entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          initializeMap();
          observer.disconnect();
        }
      },
      { rootMargin: '240px' }
    );
    observer.observe(container);
  };

  const initializeDiscover = () => {
    const root = document.querySelector('[data-discover-filters]');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const category = root.querySelector('[data-place-category]');
    const clear = root.querySelector('[data-place-clear]');
    const cards = [...document.querySelectorAll('[data-place-card]')];
    const summary = document.querySelector('[data-places-summary]');
    const empty = document.querySelector('[data-place-empty]');
    const params = new URLSearchParams(globalThis.location.search);
    const initialCategory = params.get('categoria') ?? '';

    if (
      category &&
      [...category.options].some(option => option.value === initialCategory)
    ) {
      category.value = initialCategory;
    }

    const render = (updateHistory = true) => {
      const selectedCategory = category?.value ?? '';
      const matchingCards = cards.filter(
        card => !selectedCategory || card.dataset.category === selectedCategory
      );
      cards.forEach(card => {
        card.hidden = !matchingCards.includes(card);
      });
      if (summary)
        summary.textContent = `${matchingCards.length} ${matchingCards.length === 1 ? 'lugar' : 'lugares'}`;
      if (empty) empty.hidden = matchingCards.length > 0;
      if (updateHistory) {
        const nextUrl = new URL(globalThis.location.href);
        if (selectedCategory)
          nextUrl.searchParams.set('categoria', selectedCategory);
        else nextUrl.searchParams.delete('categoria');
        globalThis.history.replaceState({}, '', nextUrl);
      }
    };

    category?.addEventListener('change', () => render());
    clear?.addEventListener('click', () => {
      if (category) category.value = '';
      render();
    });
    render(false);
  };

  document.addEventListener('astro:page-load', initializeDiscover);
  document.addEventListener('astro:page-load', observeMap);
  initializeDiscover();
  observeMap();
</script>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: 'Belmontejo',
    description: pageDescription,
    url: new URL('/descubre-belmontejo/', 'https://belmontejo.conquense.dev/')
      .href,
    touristAttraction: placeSchema,
  })}
/>

<style lang="less">
  @import '../styles/pages/descubre-belmontejo.less';
</style>
