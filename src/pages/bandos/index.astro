---
/**
 * * This page is the bandos index and displays all the bandos in a grid
 **/

export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import CTA from '@components/sections/CTA.astro';
import ContentArchive from '@components/sections/ContentArchive.astro';
import { getCollection } from 'astro:content';
import BandoMovilApp from '@components/sections/BandoMovilApp.astro';
import Landing from '@components/sections/Landing.astro';
import landingImage from '@data/landingImage';
import { homePage } from '@data/homePage';

const posts = await getCollection('bandos');
posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)
---

<BaseLayout
  title="Bandos - Ayuntamiento de Belmontejo"
  description="Consulta todos los bandos y comunicados oficiales del Ayuntamiento de Belmontejo"
  preloadedImage={landingImage}
>
  <Landing title="Bandos y avisos" image={landingImage}>
    <p>
      Consulta los comunicados oficiales publicados por el Ayuntamiento de
      Belmontejo.
    </p>
  </Landing>

  <ContentArchive
    posts={posts}
    kind="bandos"
    heading="Avisos publicados"
    searchLabel="Buscar en los bandos"
    searchPlaceholder="Título, contenido o categoría"
    resultSingular="bando publicado"
    resultPlural="bandos publicados"
    emptyMessage="No hay bandos publicados."
    linkLabel="Leer bando"
  />
  <BandoMovilApp />
  <CTA {...homePage.cta} />
</BaseLayout>
