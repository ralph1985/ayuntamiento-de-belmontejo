---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTA from '@components/sections/CTA.astro';
import Landing from '@components/sections/Landing.astro';
import ProjectDetail from '@components/sections/ProjectDetail.astro';
import { projects } from '@data/projects';
import { homePage } from '@data/homePage';
import type { Project } from '@data/projects';

export const prerender = true;

export function getStaticPaths() {
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };

import landingImage from '@data/landingImage';
---

<BaseLayout
  title={`${project.title} - Ayuntamiento de Belmontejo`}
  description={project.pageDescription}
  preloadedImage={landingImage}
>
  <Landing title={project.title} image={landingImage}>
    <p>{project.landingIntro}</p>
  </Landing>

  <ProjectDetail
    eyebrow={project.eyebrow}
    title={project.detailTitle}
    description={project.detailDescription}
    imageSrc={project.detailImageSrc ?? project.imageSrc}
    imageAlt={project.detailImageAlt ?? project.imageAlt}
    facts={project.facts}
    sourceHref={project.sourceHref}
    sourceLabel={project.sourceLabel}
  />
  <CTA {...homePage.cta} />
</BaseLayout>

<style lang="less">
  @import '../../styles/pages/proyectos.less';
</style>
