---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import CTA from '@components/sections/CTA.astro';
import FAQ from '@components/sections/FAQ.astro';
import IconBulletList from '@components/sections/IconBulletList.astro';
import HomeHero from '@components/sections/HomeHero.astro';
import VillageStory from '@components/sections/VillageStory.astro';
import HomeUpdates from '@components/sections/HomeUpdates.astro';
import HomeCommunity from '@components/sections/HomeCommunity.astro';
import { homePage } from '@data/homePage';

const homeHeroImage = {
  src: homePage.hero.desktopImage,
  width: 3838,
  height: 1632,
  format: 'webp' as const,
};
---

<BaseLayout
  title={homePage.pageTitle}
  description={homePage.pageDescription}
  preloadedImage={homeHeroImage}
>
  <HomeHero {...homePage.hero} />

  <!-- ============================================ -->
  <!--                  Services                    -->
  <!-- ============================================ -->

  <IconBulletList id="services" items={homePage.services} />

  <VillageStory {...homePage.villageStory} />

  <!-- ============================================ -->
  <!--                    FAQ                       -->
  <!-- ============================================ -->
  <FAQ id="home" />

  <HomeUpdates {...homePage.updates} />
  <HomeCommunity {...homePage.community} />

  <CTA {...homePage.cta} />
</BaseLayout>
