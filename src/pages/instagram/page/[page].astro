---
import { publishedInstagramPosts } from '@data/instagramPosts';

export const prerender = true;

export function getStaticPaths() {
  const totalPages = Math.max(1, Math.ceil(publishedInstagramPosts.length / 9));

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
    };
  });
}

return Astro.redirect('/instagram/', 301);
---
