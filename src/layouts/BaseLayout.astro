---
import { ClientRouter } from 'astro:transitions';
import type { GetImageResult } from 'astro';
import contactInfo, {
  getActiveSocialEntries,
  getPrimaryEmail,
  getPrimaryOffice,
  getPrimaryPhone,
} from '@js/contact';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import GoogleAnalytics from '@components/integrations/GoogleAnalytics.astro';
import CookieConsent from '@components/integrations/CookieConsent.astro';
import FloatingCookieManager from '@components/integrations/FloatingCookieManager.astro';
import '@styles/root.less';
import '@styles/dark.less';

// Define a type for images from the content collection
type ContentImage = {
  src: string;
  width: number;
  height: number;
  format: 'png' | 'jpg' | 'jpeg' | 'tiff' | 'webp' | 'gif' | 'svg' | 'avif';
};

// Create a union type for preloadedImage
type PreloadedImage = GetImageResult | ContentImage | string;

interface Props {
  title: string;
  description: string;
  preloadedImage?: PreloadedImage; // optional - passing a preloadedImage to BaseLayout will 1. preload the image and 2. use the image for og socials tags in the <head>
}

const { description, title, preloadedImage } = Astro.props as Props;
const preloadedImageSrc =
  typeof preloadedImage === 'string' ? preloadedImage : preloadedImage?.src;
const baseSiteUrl =
  Astro.site && Astro.site.length > 0 ? Astro.site : contactInfo.entity.domain;
const normalizedBaseUrl = baseSiteUrl.endsWith('/')
  ? baseSiteUrl
  : `${baseSiteUrl}/`;
const canonicalUrl = new URL(Astro.url.pathname, normalizedBaseUrl).href;
const primaryPhone = getPrimaryPhone();
const primaryEmail = getPrimaryEmail();
const primaryOffice = getPrimaryOffice();
const activeSocialEntries = getActiveSocialEntries();
const locationParts = [primaryOffice?.locality, primaryOffice?.region].filter(
  Boolean
);
const homeLocationSuffix =
  locationParts.length > 0 ? locationParts.join(', ') : '';
const defaultTitle = `${title} | ${contactInfo.entity.name}`;
const homeTitle = homeLocationSuffix
  ? `${defaultTitle} | ${homeLocationSuffix}`
  : defaultTitle;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  name: contactInfo.entity.name,
  url: normalizedBaseUrl,
  ...(primaryEmail?.address && { email: primaryEmail.address }),
  ...(primaryPhone?.href && { telephone: primaryPhone.href }),
  address: {
    '@type': 'PostalAddress',
    ...(primaryOffice?.street && {
      streetAddress: primaryOffice.street,
    }),
    ...(primaryOffice?.locality && {
      addressLocality: primaryOffice.locality,
    }),
    ...(primaryOffice?.region && {
      addressRegion: primaryOffice.region,
    }),
    ...(primaryOffice?.postalCode && {
      postalCode: primaryOffice.postalCode,
    }),
    addressCountry: 'ES',
  },
  logo: {
    '@type': 'ImageObject',
    url: new URL(
      '/assets/favicons/android-chrome-192x192.png',
      normalizedBaseUrl
    ).href,
  },
  ...(activeSocialEntries.length > 0 && {
    sameAs: activeSocialEntries.map(([, socialChannel]) => socialChannel.url),
  }),
};
---

<!-- A fully fleshed-out <head>, dynamically changing based on contact-info.json and the page front matter -->
<html lang="es">
  <head>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const systemIsDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;
          const theme =
            savedTheme === 'dark' || savedTheme === 'light'
              ? savedTheme
              : systemIsDark
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <!-- View Transitions support -->
    <ClientRouter />

    <!-- Standard meta tags -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- If present, preloads the image passed as a prop -->
    {
      preloadedImageSrc && (
        <link rel="preload" href={preloadedImageSrc} as="image" />
      )
    }

    <!-- Social Media Display - generated automatically with the props passd to BaseLayout -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {
      preloadedImageSrc && (
        <>
          <meta property="og:image" content={preloadedImageSrc} />
          <meta property="og:image:secure_url" content={preloadedImageSrc} />
        </>
      )
    }

    <!-- Favicons -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/favicons/apple-touch-icon.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicons/favicon-32x32.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicons/favicon-16x16.png?v=2"
    />
    <link rel="manifest" href="/assets/favicons/site.webmanifest?v=2" />
    <meta name="msapplication-TileColor" content="#17333c" />
    <meta id="theme-color" name="theme-color" content="#f5f7f3" />

    <!-- For home page, use service keywords for the title, including location for SEO.
            Other pages should just include the page name.
            
            EXAMPLE:
            Home page - House Painting Contractors | Painters and Co. | TestCity, WA
            About Page - About us | Painters and Co.
            -->
    <title>
      {Astro.url.pathname === '/' ? homeTitle : defaultTitle}
    </title>

    <!-- Sitewide Scripts -->
    <script src="@js/modalUtils.js"></script>
    <script src="@js/nav.js"></script>
    <script src="@js/cookies.js"></script>
    <script>
      import '@project-manager/pm-weather';
    </script>

    <!-- Google Analytics -->
    <GoogleAnalytics />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />
  </head>
  <body>
    <!-- Screen reader skip main nav -->
    <a class="skip" href="#main">Saltar al contenido principal</a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Cookie Consent Banner -->
    <CookieConsent />

    <!-- Floating Cookie Manager Button -->
    <FloatingCookieManager />
  </body>
</html>

<script is:inline>
  const themeColorMeta = document.querySelector('#theme-color');
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

  function updateThemeColor(theme) {
    themeColorMeta?.setAttribute(
      'content',
      theme === 'dark' ? '#14211f' : '#f5f7f3'
    );
  }

  function applyTheme(theme, persist = false) {
    const normalizedTheme = theme === 'dark' ? 'dark' : 'light';
    document.documentElement.dataset.theme = normalizedTheme;
    document.body?.classList.toggle('dark-mode', normalizedTheme === 'dark');
    if (persist) localStorage.setItem('theme', normalizedTheme);
    updateThemeColor(normalizedTheme);
    document.dispatchEvent(
      new CustomEvent('municipal:theme-change', {
        detail: { theme: normalizedTheme },
      })
    );
  }

  function restoreTheme() {
    const savedTheme = localStorage.getItem('theme');
    const theme =
      savedTheme === 'dark' || savedTheme === 'light'
        ? savedTheme
        : systemTheme.matches
          ? 'dark'
          : 'light';
    applyTheme(theme);
  }

  window.__applyMunicipalTheme = applyTheme;
  restoreTheme();
  document.addEventListener('astro:after-swap', restoreTheme);
  systemTheme.addEventListener('change', () => {
    if (!localStorage.getItem('theme')) restoreTheme();
  });
</script>
