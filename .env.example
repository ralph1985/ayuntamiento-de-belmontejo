# Google Analytics Configuration
# Replace 'GA_MEASUREMENT_ID' with your actual Google Analytics 4 Measurement ID
# You can find this in your Google Analytics account under Admin > Data Streams > Your Website
# It should look like: G-XXXXXXXXXX
# PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sonar
# SONAR_TOKEN=
# SONAR_HOST_URL=https://sonarcloud.io

# Notification sent by the bando synchronization cron after a successful push.
BANDOS_SMTP_HOST=smtp.example.com
BANDOS_SMTP_PORT=587
BANDOS_SMTP_SECURE=false
BANDOS_SMTP_USER=notifications@example.com
BANDOS_SMTP_PASSWORD=change_me
BANDOS_NOTIFY_FROM=notifications@example.com
BANDOS_NOTIFY_TO=rafaelgarcia1985@hotmail.com

# Instagram synchronization. Reads the public profile with a headless browser.
# INSTAGRAM_PROFILE_URL=https://www.instagram.com/aytobelmontejo/
# INSTAGRAM_SCRAPE_LIMIT=12
# INSTAGRAM_NAVIGATION_TIMEOUT_MS=45000
# INSTAGRAM_SMTP_HOST=smtp.example.com
# INSTAGRAM_SMTP_PORT=587
# INSTAGRAM_SMTP_SECURE=false
# INSTAGRAM_SMTP_USER=notifications@example.com
# INSTAGRAM_SMTP_PASSWORD=change_me
# INSTAGRAM_NOTIFY_FROM=notifications@example.com
# INSTAGRAM_NOTIFY_TO=rafaelgarcia1985@hotmail.com
# INSTAGRAM_SITE_URL=https://ayuntamiento-de-belmontejo.vercel.app

# Daily news discovery. SMTP falls back to the BANDOS_* values when omitted.
# Optional fallback when `gh auth token` is unavailable.
# NEWS_GITHUB_TOKEN=replace_with_a_fine_grained_token
# NEWS_SMTP_HOST=smtp.example.com
# NEWS_SMTP_PORT=587
# NEWS_SMTP_SECURE=false
# NEWS_SMTP_USER=notifications@example.com
# NEWS_SMTP_PASSWORD=change_me
# NEWS_NOTIFY_FROM=notifications@example.com
# NEWS_NOTIFY_TO=rafaelgarcia1985@hotmail.com
# NEWS_SITE_URL=https://ayuntamiento-de-belmontejo.vercel.app
# NEWS_ALLOWED_DOMAINS=vocesdecuenca.com,eldigitaldecuenca.com,eldecuenca.es,eldiarioclm.es,eldiadigital.es,clm24.es,encastillalamancha.es
